{
  "title": "test_case_intent_schema",
  "description": "Structured representation of test cases with intents.",
  "type": "object",
  "properties": {
    "tests": {
      "type": "array",
      "description": "List of individual test cases with associated intents and reference.",
      "items": {
        "type": "object",
        "properties": {
          "test_case_name": {
            "type": "string",
            "description": "Name of the individual test case."
          },
          "references": {"type": "string", "description": "Name of the file"},
          "intents": {
            "type": "array",
            "description": "List of intents within the test case.",
            "items": {
              "type": "object",
              "properties": {
                "intent": {
                  "type": "string",
                  "description": "The intent or action in the test case."
                },
                "intent_id": {
                  "type": "string",
                  "description": "Identifier for the intent step."
                }
              },
              "required": ["intent", "intent_id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["test_case_name", "references", "intents"],
        "additionalProperties": false
      }
    }
  },  
  "required": ["tests"],
  "additionalProperties": false
}
